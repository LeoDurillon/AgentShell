[
    {
        "type": "function",
        "function": {
            "name": "edit_file",
            "description": "Edit a file by inserting, replacing or deleting lines. All operations are applied bottom-to-top so line numbers stay valid.",
            "parameters": {
                "type": "object",
                "properties": {
                    "path": { "type": "string" },
                    "operations": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "properties": {
                                "type": {
                                    "type": "string",
                                    "enum": ["insert", "replace", "delete"],
                                    "description": "insert: add lines BEFORE line number. replace: replace line with new content. delete: remove line."
                                },
                                "line": {
                                    "type": "integer",
                                    "description": "Target line number (1-based)"
                                },
                                "content": {
                                    "type": "string",
                                    "description": "Line(s) to insert or replace with. Not needed for delete."
                                }
                            },
                            "required": ["type", "line"]
                        }
                    }
                },
                "required": ["path", "operations"]
            }
        }
    },
    {
        "type": "function",
        "function": {
            "name": "feature_complete",
            "description": "Call this ONLY when all behaviors from the task description are covered by passing tests and no more failing tests can be added. This ends the TDD session.",
            "parameters": {
                "type": "object",
                "properties": {
                    "summary": {
                        "type": "string",
                        "description": "List of behaviors that are now covered"
                    }
                },
                "required": ["summary"]
            }
        }
    },
    {
        "type": "function",
        "function": {
            "name": "done",
            "description": "Call this when your task is complete and no more actions are needed.",
            "parameters": {
                "type": "object",
                "properties": {
                    "summary": {
                        "type": "string",
                        "description": "Brief summary of what was done"
                    }
                },
                "required": ["summary"]
            }
        }
    }
]
